---
import Layout from '../../layouts/Layout.astro';
import { portfolioItems } from '../../data/portfolio';

const item = portfolioItems.find(i => i.slug === 'broadcast')!;
---

<Layout title={item.title} description={item.tagline}>
  <nav class="breadcrumb">
    <a href="/portfolio">Portfolio</a>
    <span class="breadcrumb-sep">→</span>
    <span class="breadcrumb-current">{item.title}</span>
  </nav>

  <article class="article-page">
    <header class="article-header">
      <h1 class="hero-title">{item.title}</h1>
      <p class="project-tagline">{item.tagline}</p>
    </header>

    <div class="project-content mx-auto">
      <div class="project-meta">
        <div class="meta-item">
          <span class="meta-label">Role</span>
          <span class="meta-value">{item.details.role}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Year</span>
          <span class="meta-value">{item.details.year}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Tools</span>
          <span class="meta-value">{item.details.tools.join(', ')}</span>
        </div>
      </div>

      <div class="article-content">
        <h2>Overview</h2>
        <p>{item.details.overview}</p>

        <div class="project-main-image">
          <img src="/images/tv.png" alt="Broadcast interface" />
        </div>

        <h2>Key Features</h2>
        <ul class="feature-list">
          {item.details.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>

        <div class="project-cta mt-4">
          <a href="/projects/broadcast" class="btn btn--primary">Launch Broadcast receiver →</a>
        </div>

        <div class="project-nav mt-4">
          <a href="/portfolio" class="btn">← All Projects</a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    color: var(--color-warm-gray);
  }
  .breadcrumb a { color: var(--accent-primary); }
  .breadcrumb-sep { opacity: 0.5; }

  .article-page { max-width: 840px; margin: 0 auto; }
  .article-header { margin-bottom: 3.5rem; padding-bottom: 0; }
  .hero-title { font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1.1; margin-bottom: 0.5rem; color: var(--text-primary); font-weight: 800; }
  .project-tagline { font-size: 1.25rem; color: var(--text-secondary); opacity: 0.8; font-weight: 400; }

  .project-content { max-width: 800px; margin: 0 auto; }

  .project-meta {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }
  .meta-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-warm-gray);
    margin-bottom: 0.4rem;
  }
  .meta-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-brown);
  }

  .project-main-image {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    margin: 3rem 0;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem;
  }
  .project-main-image img {
    max-width: 100%;
    height: auto;
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-md);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }
  .feature-list li {
    padding: 0.75rem 0 0.75rem 1.5rem;
    position: relative;
    font-size: 1.05rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-color);
  }
  .feature-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
  }

  .project-cta { text-align: center; }
</style>
