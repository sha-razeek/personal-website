---
import Layout from '../layouts/Layout.astro';
import { resumeData, education } from '../data/resume';
---

<Layout title="Resume" description="Professional experience and career history of Sha Razeek">
  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Career Path</span>
        <h1 class="hero-title">
          <span class="gradient-text">Resume</span>
        </h1>
        <p class="hero-description">
          Professional experience and career history spanning more than two decades in digital technology.
        </p>
        <div class="hero-btns mt-3">
          <button class="btn btn--primary" onclick="window.print()">
            Print / Save as PDF
          </button>
        </div>
      </div>
    </section>

    <div class="resume-content-wrapper">
      <!-- Experience -->
      <section class="resume-section">
        <div class="jet-line">
          <span>Experience</span>
        </div>
        <div class="timeline-modern stagger">
          {resumeData.map((entry) => (
            <div class="timeline-item-modern">
              <div class="timeline-meta">
                <span class="timeline-period-label">{entry.period}</span>
                <span class="timeline-company-label">{entry.company}</span>
              </div>
              <div class="timeline-info">
                <h3 class="timeline-role-title">{entry.role}</h3>
                <p class="timeline-desc-text">{entry.description}</p>
                <ul class="timeline-highlights-list">
                  {entry.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="resume-section">
        <div class="jet-line">
          <span>Education</span>
        </div>
        <div class="education-modern-grid">
          {education.map((edu) => (
            <div class="education-item-modern">
              <div class="edu-meta">
                <span class="edu-year">{edu.year}</span>
              </div>
              <div class="edu-info">
                <h3>{edu.degree}</h3>
                <p class="edu-school-name">{edu.institution}</p>
                {edu.award && (
                  <div class="edu-award-badge">
                    <span class="award-star">✦</span>
                    <span>{edu.award}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills Summary -->
      <section class="resume-section">
        <div class="jet-line">
          <span>Core Competencies</span>
        </div>
        <div class="skills-grid-modern stagger">
          <span class="skill-tag">Microsoft 365 Automation</span>
          <span class="skill-tag">Digital Graphics</span>
          <span class="skill-tag">UI/UX Design</span>
          <span class="skill-tag">Data Analysis</span>
          <span class="skill-tag">Video Production</span>
          <span class="skill-tag">Hypermedia Systems</span>
          <span class="skill-tag">Process Automation</span>
          <span class="skill-tag">Full-Stack Web Development</span>
          <span class="skill-tag">Design Systems</span>
          <span class="skill-tag">Digital Publishing</span>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    padding: 2rem 0 3rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .resume-content-wrapper {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Timeline Modern */
  .timeline-modern {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-item-modern {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    position: relative;
  }

  .timeline-item-modern::before {
    content: '';
    position: absolute;
    left: 240px;
    top: 0;
    bottom: -1.5rem;
    width: 1px;
    background: var(--border-color);
  }

  .timeline-item-modern:last-child::before {
    bottom: 0;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-period-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-primary);
  }

  .timeline-company-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brown);
  }

  .timeline-role-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .timeline-desc-text {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    max-width: 650px;
  }

  .timeline-highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .timeline-highlights-list li {
    font-size: 0.95rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-highlights-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--accent-secondary);
    font-size: 0.75rem;
  }

  /* Education Modern */
  .education-modern-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .education-item-modern {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: transform var(--transition-medium);
  }

  .education-item-modern:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .edu-meta {
    flex-shrink: 0;
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-primary);
    font-weight: 600;
  }

  .education-item-modern h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    text-transform: uppercase;
    color: var(--color-brown);
    margin-bottom: 0.5rem;
  }

  .edu-school-name {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .edu-award-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-secondary);
    text-transform: uppercase;
    background: rgba(208, 94, 60, 0.05);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  /* Skills Modern */
  .skills-grid-modern {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--color-brown);
    transition: all var(--transition-fast);
  }

  .skill-tag:hover {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  @media print {
    .hero-btns, .jet-line { display: none !important; }
    .modernist-grid { padding-bottom: 0; }
    .hero-modernist-page { padding-top: 0; }
    .timeline-item-modern { grid-template-columns: 180px 1fr; gap: 2rem; }
    .timeline-item-modern::before { left: 180px; }
  }

  @media (max-width: 768px) {
    .timeline-item-modern {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .timeline-item-modern::before {
      display: none;
    }
    .education-modern-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
