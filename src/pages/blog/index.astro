---
import Layout from '../../layouts/Layout.astro';
import { musicArticles } from '../../data/music';
---

<Layout title="Articles" description="Writing about music, technology, and design">
  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Archives</span>
        <h1 class="hero-title">
          <span class="gradient-text">Articles</span>
        </h1>
        <p class="hero-description">
          Writing about music, technology, and the things that move me.
        </p>
      </div>
    </section>

    <div class="blog-content">
      <div class="blog-modern-grid stagger">
        {musicArticles.map((article) => (
          <a href={`/blog/${article.slug}`} class="blog-item">
            <div 
              class="blog-visual" 
              style={`background: ${article.heroColor}; ${article.heroImage ? `background-image: url('${article.heroImage}'); background-size: cover; background-position: top center;` : ''}`}
            >
            </div>
            <div class="blog-info">
              <div class="blog-meta">
                <span class="blog-date">{article.date}</span>
                <span class="blog-tag">Essay</span>
              </div>
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
              <span class="blog-link">Read Article →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    padding: 2rem 0 3rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .blog-content {
    max-width: 1000px;
  }

  .blog-modern-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .blog-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-medium);
    align-items: center;
  }

  .blog-item:hover {
    transform: translateX(8px);
  }

  .blog-visual {
    width: 100%;
    aspect-ratio: 3/4; /* Tall rectangle */
    border-radius: var(--radius-lg); /* Rounded corners instead of circle */
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .blog-info h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-brown);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .blog-info p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 600px;
    color: var(--text-secondary);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .blog-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-warm-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    background: rgba(42, 157, 143, 0.06);
    border-radius: var(--radius-sm);
  }

  .blog-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-modernist-page {
      padding: 1rem 0 1.5rem;
    }
    .blog-item {
      grid-template-columns: 100px 1fr; /* Keep side-by-side but smaller image */
      gap: 1.5rem;
    }
    .blog-item:hover {
      transform: translateY(-4px);
    }
    .blog-visual {
      aspect-ratio: 3/4; /* Keep it tall */
    }
  }
</style>
