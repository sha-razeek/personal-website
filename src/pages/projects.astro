---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects" description="Featured projects and experiments by Sha Razeek">
  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Laboratory</span>
        <h1 class="hero-title">
          <span class="gradient-text">Projects</span>
        </h1>
        <p class="hero-description">
          Things I've built, experiments, and ongoing work in the digital realm.
        </p>
      </div>
    </section>

    <div class="projects-content">
      <div class="projects-modern-grid stagger">
        <!-- Transistor Radio -->
        <a href="/music/transistor" class="project-item">
          <div class="project-visual" style="background: linear-gradient(135deg, var(--color-dark), var(--accent-primary))">
            <span class="project-icon">📻</span>
          </div>
          <div class="project-info">
            <div class="project-meta">
              <span class="tag tag--coral">Live</span>
              <span class="tech-stack">JS • Web Audio</span>
            </div>
            <h3>Transistor Radio</h3>
            <p>A properly good wireless for the modern age. Search and tune into online radio stations from every corner of the globe.</p>
            <span class="project-link">Open Transistor →</span>
          </div>
        </a>

        <!-- Broadcast -->
        <a href="/projects/broadcast" class="project-item">
          <div class="project-visual" style="background: linear-gradient(135deg, #CC342D, #E76F51)">
            <span class="project-icon">📺</span>
          </div>
          <div class="project-info">
            <div class="project-meta">
              <span class="tag tag--coral">Live</span>
              <span class="tech-stack">JS • HLS.js</span>
            </div>
            <h3>Broadcast</h3>
            <p>Global telly, properly delivered. Search and tune into thousands of live television channels from across the world.</p>
            <span class="project-link">Open Broadcast →</span>
          </div>
        </a>

        <div class="jet-line"><span>✦✦✦</span></div>

        <!-- More coming soon -->
        <div class="project-item project-item--coming">
          <div class="project-visual project-visual--empty">
            <span class="project-icon">✦</span>
          </div>
          <div class="project-info">
            <h3>More Projects Coming Soon</h3>
            <p>New experiments and builds are always in progress. Check back for updates.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    padding: 2rem 0 3rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .projects-content {
    max-width: 1000px;
  }

  .projects-modern-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .project-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-medium);
    align-items: center;
  }

  .project-item:hover {
    transform: translateX(8px);
  }

  .project-visual {
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .project-visual--empty {
    background: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    box-shadow: none;
  }

  .project-icon {
    font-size: 4rem;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.15));
  }

  .project-info h3 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    text-transform: uppercase;
    color: var(--color-brown);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .project-info p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 600px;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tech-stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-warm-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .project-item--coming {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .project-item {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .project-item:hover {
      transform: translateY(-4px);
    }
    .project-visual {
      aspect-ratio: 16/9;
    }
  }
</style>
