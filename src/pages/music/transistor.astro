---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Transistor Radio" description="Listen to thousands of radio stations from around the world">
  <nav class="breadcrumb">
    <a href="/music">Music</a>
    <span class="breadcrumb-sep">→</span>
    <span class="breadcrumb-current">Transistor</span>
  </nav>

  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Soundscape</span>
        <h1 class="hero-title">
          <span class="gradient-text">Transistor</span>
        </h1>
        <p class="hero-description">
          Online radio player — Search, listen, and discover stations worldwide.
        </p>
      </div>
      <div class="header-visual">
        <img src="/images/radio.png" alt="Transistor Radio" class="radio-hero-img" />
      </div>
    </section>

    <div class="radio-app grid-section">
      <!-- Now Playing Bar -->
      <div class="now-playing" id="nowPlaying" style="display: none;">
      <div class="np-info">
        <div class="np-favicon" id="npFavicon"></div>
        <div class="np-indicator"></div>
        <div class="np-text">
          <span class="np-station" id="npStation"> - </span>
          <span class="np-country" id="npCountry"> - </span>
        </div>
      </div>
      <div class="np-controls">
        <button class="np-btn" id="btnFav" title="Add to favorites">♡</button>
        <button class="np-btn np-btn-play" id="btnPlayPause" title="Play/Pause">
          <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>
        <button class="np-btn" id="btnStop" title="Stop">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h12v12H6z"/></svg>
        </button>
        <div class="np-volume">
          <span class="vol-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
          </span>
          <input type="range" id="volumeSlider" min="0" max="100" value="75" class="vol-slider" />
        </div>
      </div>
    </div>

    <!-- Search -->
    <div class="radio-search">
      <input type="text" id="searchInput" placeholder="Search stations by name, country, or tag..." class="search-input" />
      <button class="btn btn--primary" id="btnSearch">Search</button>
      <button class="btn btn--coral" id="btnOpenMap">Explore on Map 🌐</button>
    </div>

    <!-- Map Modal -->
    <div class="modal-overlay" id="mapModal">
      <div class="modal-box map-modal-box">
        <div class="modal-header">
          <h3>Explore World Band</h3>
          <button class="modal-close" id="btnCloseMap">×</button>
        </div>
        <div class="map-modal-viewport">
          <div id="map-loading">Initialising global coordinates...</div>
          <svg id="radio-world-map"></svg>
        </div>
        <div class="map-modal-footer">
          <span class="info-label">📍 Detected:</span>
          <span id="map-country-name" class="info-value">Select a country...</span>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="radio-tabs">
      <button class="tab active" data-tab="favorites">Favorites</button>
      <button class="tab" data-tab="results">Results</button>
    </div>

    <!-- Station Lists -->
    <div class="tab-content" id="tabFavorites">
      <div class="station-list" id="favoritesList">
        <!-- Populated by JS -->
      </div>
    </div>

    <div class="tab-content" id="tabResults" style="display: none;">
      <div class="station-list" id="resultsList">
        <p class="empty-state">Search for stations above to see results.</p>
      </div>
    </div>

    <!-- Fine Print -->
    <div class="radio-fine-print">
      <p>Note: Not all radio stations may be available at all times. Stream availability depends on your network conditions and the station's server status. Some channels may be restricted to certain geographic regions (geoblocked).</p>
    </div>

    <!-- Audio element -->
    <audio id="audioPlayer" crossorigin="anonymous"></audio>
  </div>
</div>
</Layout>

<style is:global>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    color: var(--color-warm-gray);
  }
  .breadcrumb a { color: var(--accent-primary); }
  .breadcrumb-sep { opacity: 0.5; }

  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-content {
    flex: 1;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .header-visual {
    width: 320px;
    height: 320px;
    flex-shrink: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .header-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-offwhite);
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    z-index: -1;
    animation: organicMorph 10s ease-in-out infinite alternate;
  }

  @keyframes organicMorph {
    0% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    100% { border-radius: 40% 60% 70% 30% / 40% 70% 30% 60%; }
  }

  .radio-hero-img {
    width: 80%;
    height: 80%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.15));
    transition: transform var(--transition-medium);
  }

  .header-visual:hover .radio-hero-img {
    transform: scale(1.1) rotate(2deg);
  }

  @media (max-width: 768px) {
    .hero-modernist-page {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .header-visual {
      order: -1;
      width: 240px;
      height: 240px;
    }
  }

  .radio-app {
    max-width: 840px;
  }

  /* Now Playing */
  .now-playing {
    background: var(--color-dark);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation: fadeInUp 0.3s var(--ease-out);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .np-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .np-favicon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .np-favicon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .np-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-secondary);
    animation: gentlePulse 1.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  .np-station {
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-country {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .np-btn {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: white;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
  }

  .np-btn:hover {
    background: rgba(255,255,255,0.2);
  }

  .np-btn-play {
    width: 52px;
    height: 52px;
    background: var(--accent-primary);
    font-size: 1.15rem;
  }

  .np-btn-play:hover {
    background: var(--accent-secondary);
  }

  .np-volume {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.5rem;
  }

  .vol-icon {
    display: flex;
    align-items: center;
    color: white;
    opacity: 0.8;
  }

  .vol-slider {
    width: 70px;
    height: 3px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255,255,255,0.2);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-mustard);
    cursor: pointer;
  }

  /* Search */
  .radio-search {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  /* Map Modal Styles */
  .map-modal-box {
    max-width: 900px;
    width: 95%;
    padding: 0;
    overflow: hidden;
  }

  .modal-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h3 { margin-bottom: 0; }

  .modal-close {
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-warm-gray);
  }

  .map-modal-viewport {
    width: 100%;
    height: 50vh;
    min-height: 350px;
    background: var(--bg-secondary);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
  }

  #radio-world-map { width: 100%; height: 100%; }

  .map-modal-footer {
    padding: 1rem 1.5rem;
    background: white;
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .info-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--color-warm-gray);
  }

  .info-value {
    font-weight: 600;
    color: var(--accent-primary);
  }

  /* D3 Map Specific Styles */
  .map-country {
    fill: #2A9D8F;
    fill-opacity: 0.7;
    stroke: white;
    stroke-width: 0.5px;
    transition: all 0.2s;
  }

  .map-country:hover {
    fill: #E76F51;
    fill-opacity: 1;
    cursor: pointer;
  }

  .map-country.selected {
    fill: #E9C46A;
    fill-opacity: 1;
  }

  .map-sphere { fill: #fdfdfd; opacity: 0.5; }
  .map-graticule { fill: none; stroke: var(--border-color); stroke-width: 0.5px; stroke-dasharray: 2,2; }

  .search-input {
    flex: 1;
    padding: 0.65rem 1rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-md);
    background: white;
    color: var(--text-primary);
    transition: border-color var(--transition-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent-primary);
  }

  /* Tabs */
  .radio-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .tab {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.6rem 1rem;
    border: none;
    background: none;
    color: var(--color-warm-gray);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .tab:hover {
    color: var(--text-primary);
  }

  .tab.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }

  /* Station List */
  .station-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .station-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 1.5rem 1.25rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .station-item:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .station-item.playing {
    border-color: var(--accent-primary);
    background: rgba(42, 157, 143, 0.06);
  }

  .station-info {
    flex: 1;
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0 0 1rem;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  .station-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: var(--color-brown);
  }

  .station-country {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .station-codec {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-warm-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .station-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    justify-content: center;
    padding: 0.3rem 1.1rem 1rem;
  }

  .station-btn {
    width: 42px;
    height: 42px;
    border: 2px solid var(--color-warm-gray);
    border-radius: 50%;
    background: var(--color-offwhite);
    cursor: pointer;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-medium);
    color: var(--color-charcoal);
    box-shadow: 0 2px 0 var(--color-warm-gray);
  }

  .station-btn:active {
    transform: translateY(2px);
    box-shadow: none;
  }

  .station-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: rgba(42, 157, 143, 0.06);
    box-shadow: 0 2px 0 var(--accent-primary);
  }

  .station-btn.fav-active {
    color: var(--accent-secondary);
    border-color: var(--accent-secondary);
    background: rgba(231, 111, 81, 0.08);
    box-shadow: 0 2px 0 var(--accent-secondary);
  }

  .station-btn.fav-active:hover {
    color: white;
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  .empty-state, .loading-text, #map-loading {
    text-align: center;
    padding: 3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-warm-gray);
  }

  .radio-fine-print {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-warm-gray);
    line-height: 1.6;
    text-align: center;
    opacity: 0.8;
  }

  .radio-fine-print p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .now-playing {
      flex-direction: column;
      gap: 0.75rem;
    }
    .np-volume { display: none; }
    .radio-search { flex-direction: column; }
    .map-modal-viewport { height: 40vh; min-height: 250px; }
  }
</style>

<script>
  import * as d3 from 'd3';

  // Transistor Radio Player
  const API_BASE = 'https://de1.api.radio-browser.info/json';

  interface Station {
    stationuuid: string;
    name: string;
    url: string;
    url_resolved: string;
    country: string;
    countrycode: string;
    favicon: string;
    tags: string;
    codec: string;
    bitrate: number;
  }

  // State
  let currentStation: Station | null = null;
  let favorites: Station[] = [];
  let isPlaying = false;
  let mapInitialised = false;

  const audio = document.getElementById('audioPlayer') as HTMLAudioElement;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const nowPlaying = document.getElementById('nowPlaying')!;
  const npStation = document.getElementById('npStation')!;
  const npCountry = document.getElementById('npCountry')!;
  const btnPlayPause = document.getElementById('btnPlayPause')!;
  const btnStop = document.getElementById('btnStop')!;
  const btnFav = document.getElementById('btnFav')!;
  const npFavicon = document.getElementById('npFavicon')!;
  const btnSearch = document.getElementById('btnSearch')!;
  const volumeSlider = document.getElementById('volumeSlider') as HTMLInputElement;
  const favoritesList = document.getElementById('favoritesList')!;
  const resultsList = document.getElementById('resultsList')!;
  
  // Map Elements
  const btnOpenMap = document.getElementById('btnOpenMap')!;
  const btnCloseMap = document.getElementById('btnCloseMap')!;
  const mapModal = document.getElementById('mapModal')!;
  const mapCountryName = document.getElementById('map-country-name')!;

  // Default favorites
  const defaultFavorites: Station[] = [
    {
      stationuuid: 'default-cna',
      name: 'CNA 938 Live',
      url: 'https://playerservices.streamtheworld.com/api/livestream-redirect/938NOW_PREM.aac',
      url_resolved: 'https://playerservices.streamtheworld.com/api/livestream-redirect/938NOW_PREM.aac',
      country: 'Singapore',
      countrycode: 'SG',
      favicon: '',
      tags: 'news,talk',
      codec: 'AAC',
      bitrate: 128,
    },
    {
      stationuuid: 'default-bbc',
      name: 'BBC World Service',
      url: 'https://stream.live.vc.bbcmedia.co.uk/bbc_world_service_east_asia',
      url_resolved: 'https://stream.live.vc.bbcmedia.co.uk/bbc_world_service_east_asia', 
      country: 'United Kingdom',
      countrycode: 'GB',
      favicon: '',
      tags: 'news,talk',
      codec: 'MP3',
      bitrate: 128,
    },
  ];

  // Init
  function init() {
    const saved = localStorage.getItem('transistor-favorites');
    favorites = saved ? JSON.parse(saved) : [...defaultFavorites];
    renderFavorites();
    setupTabs();
    setupEventListeners();
    audio.volume = 0.75;
  }

  function saveFavorites() {
    localStorage.setItem('transistor-favorites', JSON.stringify(favorites));
  }

  // Tabs
  function setupTabs() {
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const tabName = tab.getAttribute('data-tab')!;
        document.querySelectorAll('.tab-content').forEach(c => (c as HTMLElement).style.display = 'none');
        const target = document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1))!;
        target.style.display = 'block';
      });
    });
  }

  // Event Listeners
  function setupEventListeners() {
    btnSearch.addEventListener('click', searchStations);
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchStations();
    });

    btnOpenMap.addEventListener('click', () => {
      mapModal.classList.add('active');
      if (!mapInitialised) initMap();
    });

    btnCloseMap.addEventListener('click', () => mapModal.classList.remove('active'));
    mapModal.addEventListener('click', (e) => { if (e.target === mapModal) mapModal.classList.remove('active'); });

    btnPlayPause.addEventListener('click', () => {
      if (isPlaying) {
        audio.pause();
      } else if (currentStation) {
        audio.src = currentStation.url_resolved;
        audio.play();
      }
    });

    btnStop.addEventListener('click', stopPlayback);

    btnFav.addEventListener('click', () => {
      if (currentStation) toggleFavorite(currentStation);
    });

    volumeSlider.addEventListener('input', () => {
      audio.volume = parseInt(volumeSlider.value) / 100;
    });

    audio.addEventListener('play', () => {
      isPlaying = true;
      (btnPlayPause.querySelector('.icon-play') as HTMLElement).style.display = 'none';
      (btnPlayPause.querySelector('.icon-pause') as HTMLElement).style.display = 'block';
      if (currentStation) {
        document.querySelectorAll('.station-item').forEach(el => el.classList.remove('playing'));
        const el = document.querySelector(`[data-station-id="${currentStation.stationuuid}"]`);
        el?.classList.add('playing');
      }
    });

    audio.addEventListener('pause', () => {
      isPlaying = false;
      (btnPlayPause.querySelector('.icon-play') as HTMLElement).style.display = 'block';
      (btnPlayPause.querySelector('.icon-pause') as HTMLElement).style.display = 'none';
    });

    audio.addEventListener('error', () => {
      isPlaying = false;
      (btnPlayPause.querySelector('.icon-play') as HTMLElement).style.display = 'block';
      (btnPlayPause.querySelector('.icon-pause') as HTMLElement).style.display = 'none';
    });
  }

  // Map Discovery
  async function initMap() {
    const svg = d3.select('#radio-world-map');
    const loading = document.getElementById('map-loading');
    const width = 900;
    const height = 500;
    const geojsonUrl = 'https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson';

    svg.attr('viewBox', `0 0 ${width} ${height}`).attr('preserveAspectRatio', 'xMidYMid meet');
    const g = svg.append('g');

    // Mercator projection
    const projection = d3.geoMercator().scale(140).translate([width / 2, height / 1.5]);
    const path = d3.geoPath().projection(projection);

    const zoom = d3.zoom().scaleExtent([1, 8]).on('zoom', (e) => g.attr('transform', e.transform));
    svg.call(zoom);

    try {
      const data = await d3.json(geojsonUrl) as any;
      if (loading) loading.style.display = 'none';

      // Sea
      g.append('path').datum({type: 'Sphere'}).attr('fill', '#f8f9fa').attr('d', path);
      // Grid
      g.append('path').datum(d3.geoGraticule()).attr('class', 'map-graticule').attr('d', path);

      // Countries
      g.selectAll('path.country')
        .data(data.features)
        .enter()
        .append('path')
        .attr('class', 'map-country')
        .attr('d', path)
        .on('click', (event, d: any) => {
          const country = d.properties.name;
          if (mapCountryName) mapCountryName.innerText = country;
          
          // Execute Search
          searchInput.value = country;
          searchStations();
          
          // Visual feedback and close
          d3.selectAll('.map-country').classed('selected', false);
          d3.select(event.currentTarget).classed('selected', true);
          
          setTimeout(() => {
            mapModal.classList.remove('active');
          }, 600);
        });

      mapInitialised = true;
    } catch (error) {
      if (loading) loading.innerText = 'Unable to load map.';
    }
  }

  // Search
  async function searchStations() {
    const query = searchInput.value.trim();
    if (!query) return;

    resultsList.innerHTML = '<p class="loading-text">Searching...</p>';

    try {
      const res = await fetch(`${API_BASE}/stations/search?name=${encodeURIComponent(query)}&limit=30&order=votes&reverse=true&hidebroken=true`);
      const stations: Station[] = await res.json();
      renderStations(stations, resultsList);

      // Switch to results tab
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelector('[data-tab="results"]')?.classList.add('active');
      document.querySelectorAll('.tab-content').forEach(c => (c as HTMLElement).style.display = 'none');
      document.getElementById('tabResults')!.style.display = 'block';
    } catch {
      resultsList.innerHTML = '<p class="empty-state">Error fetching results. Please try again.</p>';
    }
  }

  // Render
  function renderStations(stations: Station[], container: HTMLElement) {
    if (stations.length === 0) {
      container.innerHTML = '<p class="empty-state">No stations found.</p>';
      return;
    }

    container.innerHTML = stations.map(s => `
      <div class="station-item" data-station-id="${s.stationuuid}">
        <div class="station-info">
          <div class="station-name">${escapeHtml(s.name)}</div>
          <div class="station-country">${escapeHtml(s.country)}</div>
          <div class="station-codec">${s.codec} · ${s.bitrate}k</div>
        </div>
        <div class="station-actions">
          <button class="station-btn fav-btn ${isFavorite(s.stationuuid) ? 'fav-active' : ''}" data-uuid="${s.stationuuid}" title="Favorite">
            ${isFavorite(s.stationuuid) ? '♥' : '♡'}
          </button>
          <button class="station-btn play-btn" data-uuid="${s.stationuuid}" title="Play">▶</button>
        </div>
      </div>
    `).join('');

    // Bind events
    container.querySelectorAll('.play-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const uuid = btn.getAttribute('data-uuid')!;
        const station = stations.find(s => s.stationuuid === uuid);
        if (station) playStation(station);
      });
    });

    container.querySelectorAll('.fav-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const uuid = btn.getAttribute('data-uuid')!;
        const station = stations.find(s => s.stationuuid === uuid);
        if (station) toggleFavorite(station);
      });
    });

    container.querySelectorAll('.station-item').forEach(item => {
      item.addEventListener('click', () => {
        const uuid = item.getAttribute('data-station-id')!;
        const station = stations.find(s => s.stationuuid === uuid);
        if (station) playStation(station);
      });
    });
  }

  function renderFavorites() {
    if (favorites.length === 0) {
      favoritesList.innerHTML = '<p class="empty-state">No favorites yet. Search and add stations!</p>';
      return;
    }
    renderStations(favorites, favoritesList);
  }

  // Playback
  function playStation(station: Station) {
    currentStation = station;
    audio.src = station.url_resolved;
    audio.play();

    nowPlaying.style.display = 'flex';
    npStation.textContent = station.name;
    npCountry.textContent = `${station.country} · ${station.codec} ${station.bitrate}k`;
    if (station.favicon) {
      npFavicon.innerHTML = `<img src="${station.favicon}" alt="" width="40" height="40">`;
      npFavicon.style.display = 'flex';
    } else {
      npFavicon.innerHTML = '';
      npFavicon.style.display = 'none';
    }
    btnFav.textContent = isFavorite(station.stationuuid) ? '♥' : '♡';
  }

  function stopPlayback() {
    audio.pause();
    audio.src = '';
    isPlaying = false;
    (btnPlayPause.querySelector('.icon-play') as HTMLElement).style.display = 'block';
    (btnPlayPause.querySelector('.icon-pause') as HTMLElement).style.display = 'none';
    currentStation = null;
    nowPlaying.style.display = 'none';
    npFavicon.innerHTML = '';
    npFavicon.style.display = 'none';
    document.querySelectorAll('.station-item').forEach(el => el.classList.remove('playing'));
  }

  // Favorites
  function isFavorite(uuid: string): boolean {
    return favorites.some(f => f.stationuuid === uuid);
  }

  function toggleFavorite(station: Station) {
    if (isFavorite(station.stationuuid)) {
      favorites = favorites.filter(f => f.stationuuid !== station.stationuuid);
    } else {
      favorites.push(station);
    }
    saveFavorites();
    renderFavorites();

    if (currentStation && currentStation.stationuuid === station.stationuuid) {
      btnFav.textContent = isFavorite(station.stationuuid) ? '♥' : '♡';
    }

    // Re-render results/top to update fav buttons
    document.querySelectorAll('.fav-btn').forEach(btn => {
      const uuid = btn.getAttribute('data-uuid');
      if (uuid) {
        btn.classList.toggle('fav-active', isFavorite(uuid));
        btn.textContent = isFavorite(uuid) ? '♥' : '♡';
      }
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  init();
</script>
