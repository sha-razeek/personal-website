---
import Layout from '../layouts/Layout.astro';
import { myGear } from '../data/gear';

const categories = ['Computing', 'Display', 'Peripherals', 'Audio', 'Storage'];
---

<Layout title="My Gear" description="The hardware and tools behind my daily workflow and desk setup">
  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Toolkit</span>
        <h1 class="hero-title">
          <span class="gradient-text">My Gear</span>
        </h1>
        <p class="hero-description">
          The hardware and tools behind my daily workflow and digital craftsmanship.
        </p>
      </div>
    </section>

    <section class="grid-section gear-hero">
      <div class="hero-image-frame">
        <img src="/images/desk-setup.jpg" alt="Sha Razeek's Desk Setup" class="hero-image" />
        <div class="image-label">Desk Setup 2025</div>
      </div>
    </section>

    <div class="gear-content-wrapper">
      {categories.map(cat => {
        const items = myGear.filter(item => item.category === cat);
        if (items.length === 0) return null;
        
        return (
          <section class="gear-section">
            <div class="jet-line">
              <span>{cat}</span>
            </div>
            
            <div class="gear-modern-grid stagger">
              {items.map(item => (
                <div class="gear-item">
                  <div class="gear-info">
                    <span class="gear-brand">{item.brand}</span>
                    <h3>{item.name}</h3>
                    {item.specs && <p class="gear-specs">{item.specs}</p>}
                    {item.description && <p class="gear-desc">{item.description}</p>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    padding: 2rem 0 3rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .gear-hero {
    margin-bottom: 2rem;
  }

  .hero-image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 21/9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--bg-secondary);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.05) contrast(1.02);
    transition: transform var(--transition-medium);
  }

  .image-label {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: white;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: var(--radius-sm);
    color: var(--color-brown);
    box-shadow: var(--shadow-sm);
  }

  .gear-content-wrapper {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .gear-modern-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .gear-item {
    background: white;
    padding: 2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    transition: all var(--transition-medium);
    border-top: 3px solid var(--border-color);
  }

  .gear-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-top-color: var(--accent-primary);
  }

  .gear-brand {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .gear-item h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .gear-specs {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .gear-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .gear-modern-grid {
      grid-template-columns: 1fr;
    }
    .hero-image-frame {
      aspect-ratio: 16/9;
    }
  }
</style>
