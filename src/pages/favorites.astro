---
import Layout from '../layouts/Layout.astro';
import { favorites } from '../data/favorites';

// Find the first index of each type to allow jumping
const categories = [
  { id: 'book', label: 'Books' },
  { id: 'movie', label: 'Movies' },
  { id: 'tv', label: 'TV Shows' },
  { id: 'music', label: 'Music' }
].filter(cat => favorites.some(f => f.type === cat.id));

// Group favorites to ensure they are sequential for jumping
const sortedFavorites = [
  ...favorites.filter(f => f.type === 'book'),
  ...favorites.filter(f => f.type === 'movie'),
  ...favorites.filter(f => f.type === 'tv'),
  ...favorites.filter(f => f.type === 'music')
];

---

<Layout title="Favorites" description="Recommended books, movies, TV shows, and music albums by Sha Razeek">
  <div class="scroll-wrapper" id="scroll-wrapper">
    <div class="sticky-container">
      
      <section class="grid-section hero-modernist-page">
        <div class="hero-content">
          <span class="hero-eyebrow">The Curated List</span>
          <h1 class="hero-title">
            <span class="gradient-text">Favorites</span>
          </h1>
          <p class="hero-description">
            A collection of beautiful things that have inspired, moved, and entertained me. Scroll down to explore.
          </p>
          
          <div class="category-nav">
            {categories.map(cat => (
              <button class="cat-btn" data-target={cat.id}>{cat.label}</button>
            ))}
          </div>
        </div>
      </section>

      <div class="horizontal-list" id="horizontal-list">
          {sortedFavorites.map((item, index) => {
            // Mark the first item of each category
            const isFirstOfCategory = index === 0 || sortedFavorites[index-1].type !== item.type;
            return (
              <div 
                class="favorite-item" 
                data-type={item.type} 
                id={isFirstOfCategory ? `cat-${item.type}` : undefined}
              >
                <div class="favorite-visual">
                  <img 
                    src={item.coverImage || `https://placehold.co/${item.type === 'music' ? '400x400' : '400x600'}/f4f1ea/264653?text=${encodeURIComponent(item.title)}`} 
                    alt={item.title} 
                    class="favorite-img"
                  />
                </div>
                
                <div class="favorite-info">
                  <div class="favorite-header-row">
                    <h3>{item.title}</h3>
                    {item.year && <span class="favorite-year">{item.year}</span>}
                  </div>
                  
                  <p class="favorite-creator">{item.creator}</p>
                  
                  {item.description && <p class="favorite-desc">{item.description}</p>}

                  <div class="favorite-meta">
                    <span class="type-tag">{item.type}</span>
                    {item.country && <span class="country-label">{item.country}</span>}
                  </div>
                </div>
              </div>
            );
          })}
          
          <div class="scroll-end-spacer">
            <span class="end-mark">Fin.</span>
          </div>
        </div>
        
        <!-- Custom horizontal scrollbar/progress indicator -->
        <div class="progress-bar-container">
          <div class="progress-bar-track">
            <div class="progress-bar-thumb" id="progress-thumb"></div>
          </div>
        </div>
      </div>
    </div>

  <script>
    function initHorizontalScroll() {
      const wrapper = document.getElementById('scroll-wrapper');
      const container = wrapper?.querySelector('.sticky-container');
      const list = document.getElementById('horizontal-list');
      const thumb = document.getElementById('progress-thumb');
      const catBtns = document.querySelectorAll('.cat-btn');
      
      if (!wrapper || !list || !thumb || !container) return;

      function updateHeight() {
        const listWidth = list.scrollWidth;
        const containerWidth = container.offsetWidth;
        const viewportHeight = window.innerHeight;
        
        const scrollHeight = (listWidth - containerWidth) + viewportHeight;
        wrapper.style.height = `${scrollHeight}px`;
      }

      function handleScroll() {
        const rect = wrapper.getBoundingClientRect();
        const listWidth = list.scrollWidth;
        const containerWidth = container.offsetWidth;
        const maxOffset = listWidth - containerWidth;
        
        let progress = 0;
        
        if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
          const offset = -rect.top;
          list.style.transform = `translateX(-${offset}px)`;
          progress = offset / maxOffset;
        } else if (rect.top > 0) {
          list.style.transform = `translateX(0px)`;
          progress = 0;
        } else if (rect.bottom < window.innerHeight) {
          list.style.transform = `translateX(-${maxOffset}px)`;
          progress = 1;
        }
        
        // Update progress thumb
        thumb.style.transform = `scaleX(${progress})`;
      }

      function jumpToCategory(e: Event) {
        const btn = e.currentTarget as HTMLButtonElement;
        const catId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(`cat-${catId}`);
        
        if (targetEl && wrapper && container) {
          const listWidth = list.scrollWidth;
          const containerWidth = container.offsetWidth;
          const maxOffset = listWidth - containerWidth;
          
          // Get horizontal offset of the target element
          const horizontalOffset = targetEl.offsetLeft - 40; // Some padding
          
          // Clamp offset
          const clampedOffset = Math.max(0, Math.min(horizontalOffset, maxOffset));
          
          // Calculate vertical position
          const wrapperTop = wrapper.offsetTop;
          window.scrollTo({
            top: wrapperTop + clampedOffset,
            behavior: 'smooth'
          });
        }
      }

      catBtns.forEach(btn => btn.addEventListener('click', jumpToCategory));
      window.addEventListener('scroll', handleScroll);
      window.addEventListener('resize', () => {
        updateHeight();
        handleScroll();
      });

      // Initial call
      updateHeight();
      handleScroll();
      
      window.addEventListener('load', updateHeight);
    }

    initHorizontalScroll();
    document.addEventListener('astro:page-load', initHorizontalScroll);
  </script>
</Layout>

<style>
  :global(.main-content) {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    flex: 0 0 auto;
    padding: 0 0 1rem;
    width: 100%;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .category-nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--color-brown);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cat-btn:hover {
    background: var(--color-brown);
    color: white;
    transform: translateY(-2px);
  }

  /* Horizontal Scroll Styles */
  .scroll-wrapper {
    position: relative;
    width: calc(100% + var(--page-padding));
    margin-right: calc(var(--page-padding) * -1);
  }

  .sticky-container {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-top: var(--page-padding);
  }

  .horizontal-list {
    display: flex;
    gap: 4rem;
    padding: 0 10rem 0 0;
    will-change: transform;
    flex: 1;
    align-items: center;
  }

  .favorite-item {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform var(--transition-medium);
    flex: 0 0 380px;
  }

  .favorite-item:hover {
    transform: translateY(-8px);
  }

  .favorite-visual {
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--bg-secondary);
  }

  .favorite-item[data-type="book"] .favorite-visual,
  .favorite-item[data-type="movie"] .favorite-visual,
  .favorite-item[data-type="tv"] .favorite-visual {
    aspect-ratio: 2/3;
  }

  .favorite-item[data-type="music"] .favorite-visual {
    aspect-ratio: 1;
  }

  .favorite-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--transition-medium);
  }

  .favorite-item:hover .favorite-img {
    transform: scale(1.05);
  }

  .favorite-info h3 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    text-transform: uppercase;
    color: var(--color-brown);
    margin-bottom: 0.25rem;
    line-height: 1.1;
  }

  .favorite-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .favorite-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-warm-gray);
  }

  .favorite-creator {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .favorite-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .favorite-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .type-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-secondary);
    padding: 0.2rem 0.5rem;
    background: rgba(208, 94, 60, 0.06);
    border-radius: var(--radius-sm);
  }

  .country-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-warm-gray);
    text-transform: uppercase;
  }

  .scroll-end-spacer {
    flex: 0 0 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .end-mark {
    font-family: var(--font-serif);
    font-size: 4rem;
    color: var(--color-warm-gray);
    opacity: 0.3;
    text-transform: uppercase;
  }

  /* Progress Bar */
  .progress-bar-container {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    height: 4px;
    display: flex;
    align-items: center;
    z-index: 100;
  }

  .progress-bar-track {
    width: 100%;
    height: 1px;
    background: var(--border-color);
    position: relative;
  }

  .progress-bar-thumb {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: 100%;
    background: var(--accent-primary);
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
    border-radius: 4px;
  }

  @media (max-width: 1024px) {
    .favorite-item {
      flex: 0 0 320px;
    }
  }

  @media (max-width: 768px) {
    /* On mobile, revert to normal vertical scroll for better UX */
    .sticky-container {
      position: relative;
      height: auto;
      overflow: visible;
      padding-top: 0;
    }
    .scroll-wrapper {
      height: auto !important;
      width: 100%;
      margin-right: 0;
    }
    .horizontal-list {
      flex-direction: column;
      transform: none !important;
      padding: 2rem 0;
      gap: 3rem;
    }
    .favorite-item {
      flex: 1;
    }
    .scroll-end-spacer {
      display: none;
    }
    .progress-bar-container {
      display: none;
    }
    .category-nav {
      display: none;
    }
  }
</style>
