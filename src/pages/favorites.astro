---
import Layout from '../layouts/Layout.astro';
import { favorites } from '../data/favorites';

const categories = [
  { id: 'book', label: 'Books' },
  { id: 'movie', label: 'Movies' },
  { id: 'tv', label: 'TV Shows' },
  { id: 'music', label: 'Music' }
].filter(cat => favorites.some(f => f.type === cat.id));

const getFavoritesByType = (type: string) => favorites.filter(f => f.type === type);

---

<Layout title="Favorites" description="Recommended books, movies, TV shows, and music albums by Sha Razeek">
  
  <div class="modernist-grid">
    <!-- Hero Section -->
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <span class="hero-eyebrow">The Curated List</span>
        <h1 class="hero-title">
          <span class="gradient-text">Favorites</span>
        </h1>
        <p class="hero-description">
          A collection of beautiful things that have inspired, moved, and entertained me.
        </p>
        
        <div class="category-nav">
          {categories.map(cat => (
            <a href={`#${cat.id}`} class="cat-btn">{cat.label}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- Categories -->
    {categories.map((cat) => (
      <section class="grid-section favorite-category" id={cat.id}>
        <div class="section-header">
          <div class="jet-line-header">
            <span>{cat.label}</span>
          </div>
        </div>
        
        <div class="favorites-grid">
          {getFavoritesByType(cat.id).map((item) => (
            <div class="favorite-item" data-type={item.type}>
              <div class="favorite-visual">
                <img 
                  src={item.coverImage || `https://placehold.co/${item.type === 'music' ? '400x400' : '400x600'}/f4f1ea/264653?text=${encodeURIComponent(item.title)}`} 
                  alt={item.title} 
                  class="favorite-img"
                  loading="lazy"
                />
              </div>
              
              <div class="favorite-info">
                <div class="favorite-header-row">
                  <h3>{item.title}</h3>
                  {item.year && <span class="favorite-year">{item.year}</span>}
                </div>
                
                <p class="favorite-creator">{item.creator}</p>
                
                {item.description && <p class="favorite-desc">{item.description}</p>}

                <div class="favorite-meta">
                  <span class="type-tag">{item.type}</span>
                  {item.country && <span class="country-label">{item.country}</span>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-bottom: 6rem;
  }

  .grid-section {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .hero-modernist-page {
    padding-top: 4rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 3rem;
  }

  .category-nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--color-brown);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .cat-btn:hover {
    background: var(--color-brown);
    color: white;
    transform: translateY(-2px);
  }

  .section-header {
    margin-bottom: 3rem;
    scroll-margin-top: 2rem;
  }

  .jet-line-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .jet-line-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-color);
  }

  .jet-line-header span {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    text-transform: uppercase;
    color: var(--color-brown);
    font-weight: 800;
  }

  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 3rem 2.5rem;
  }

  .favorite-item {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform var(--transition-medium);
  }

  .favorite-item:hover {
    transform: translateY(-8px);
  }

  .favorite-visual {
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--bg-secondary);
  }

  .favorite-item[data-type="book"] .favorite-visual,
  .favorite-item[data-type="movie"] .favorite-visual,
  .favorite-item[data-type="tv"] .favorite-visual {
    aspect-ratio: 2/3;
  }

  .favorite-item[data-type="music"] .favorite-visual {
    aspect-ratio: 1;
  }

  .favorite-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--transition-medium);
  }

  .favorite-item:hover .favorite-img {
    transform: scale(1.05);
  }

  .favorite-info h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--color-brown);
    margin-bottom: 0.25rem;
    line-height: 1.1;
  }

  .favorite-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .favorite-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-warm-gray);
  }

  .favorite-creator {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .favorite-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .favorite-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .type-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-secondary);
    padding: 0.2rem 0.5rem;
    background: rgba(208, 94, 60, 0.06);
    border-radius: var(--radius-sm);
  }

  .country-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-warm-gray);
    text-transform: uppercase;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .favorites-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .modernist-grid { gap: 3rem; }
    .hero-title { font-size: 4rem; }
    .jet-line-header span { font-size: 1.8rem; }
    .favorites-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .favorite-info h3 { font-size: 1.3rem; }
  }
</style>
