---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Sha Razeek, Developer, Hypermedia and UI/UX Specialist">
  <div class="modernist-grid">
    <section class="grid-section hero-modernist-page">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="gradient-text">About</span>
        </h1>
        <p class="hero-description">
          A self-taught designer and developer with more than two decades of experience.
        </p>
      </div>
    </section>

    <div class="about-content mx-auto">
      <div class="about-intro">
        <div class="about-photo">
          <div class="about-photo-frame">
            <img src="/images/me.jpg" alt="Sha Razeek" class="about-img" />
            <div class="about-photo-accent"></div>
          </div>
        </div>
        <div class="about-text">
          <p class="about-lead">
            I'm Sha Razeek, a developer, hypermedia specialist, and UI/UX designer with the better part
            of two decades under my belt, spanning full-stack web development, video production, digital publishing, 
            and creative technology.
          </p>
          <p>
            With a background in statistics and computer science and a penchant for all things beautiful in digital
            design, I've treaded the intersection of technology and design, building digital experiences
            that are every bit as elegant as they are functional.
          </p>
          <p>
            Nowadays, I concentrate on hypermedia systems, web development, and the art of crafting
            interfaces that channel the optimism and refinement of mid-century modern design, all whilst
            leveraging contemporary web standards.
          </p>
        </div>
      </div>

      <div class="jet-line"><span>✦✦✦</span></div>

      <section class="about-section">
        <h2 class="serif-label">What I Do</h2>
        <div class="skills-grid stagger">
          <div class="skill-card">
            <span class="skill-icon">◈</span>
            <h3>Development</h3>
            <p>Full-stack web development with modern frameworks, APIs, and cloud-native architectures.</p>
          </div>
          <div class="skill-card">
            <span class="skill-icon">◎</span>
            <h3>UI/UX Design</h3>
            <p>User-centred design with a keen focus on typography, motion, and visual systems.</p>
          </div>
          <div class="skill-card">
            <span class="skill-icon">✦</span>
            <h3>Hypermedia</h3>
            <p>Building interconnected digital experiences that make proper use of the web's native linking capabilities.</p>
          </div>
          <div class="skill-card">
            <span class="skill-icon">♫</span>
            <h3>Creative Tech</h3>
            <p>Exploring the boundaries between art, music, and technology through interactive projects.</p>
          </div>
        </div>
      </section>

      <div class="about-cta mt-4">
        <a href="/resume" class="btn btn--primary">View Resume</a>
        <a href="/portfolio" class="btn">See My Work</a>
        <a href="mailto:sharazeek@atomicmail.io" class="btn">Contact Me</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .modernist-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .grid-section {
    width: 100%;
  }

  .hero-modernist-page {
    padding: 2rem 0 3rem;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.85;
    font-weight: 900;
    color: var(--color-brown);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(
      135deg, 
      var(--color-brown) 0%, 
      var(--accent-primary) 25%, 
      var(--accent-secondary) 50%, 
      var(--accent-primary) 75%, 
      var(--color-brown) 100%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmeryText 12s linear infinite;
    display: inline-block;
  }

  @keyframes shimmeryText {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .justify-center { justify-content: center; }

  .about-content {
    max-width: 1000px;
    width: 100%;
  }

  .about-intro {
    display: flex;
    gap: 4rem;
    align-items: flex-start;
    margin-bottom: 4rem;
  }

  .about-photo {
    flex-shrink: 0;
  }

  .about-photo-frame {
    position: relative;
    width: 320px;
    height: 320px;
    z-index: 5;
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: var(--shadow-lg);
    filter: grayscale(100%);
    transition: all var(--transition-medium);
  }

  .about-photo-frame:hover .about-img {
    filter: grayscale(0%);
    transform: scale(1.02);
  }

  .about-photo-accent {
    position: absolute;
    inset: -20px;
    background: var(--color-offwhite);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    z-index: -1;
    animation: organicMorph 15s ease-in-out infinite alternate;
  }

  @keyframes organicMorph {
    0% { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; transform: scale(1) rotate(0deg); }
    100% { border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%; transform: scale(1.05) rotate(5deg); }
  }

  .about-text {
    flex: 1;
  }

  .about-lead {
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--text-primary);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .serif-label {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    text-transform: uppercase;
    color: var(--color-brown);
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .skill-card {
    padding: 2.5rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all var(--transition-medium);
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .skill-icon {
    font-size: 1.5rem;
    color: var(--accent-primary);
    display: block;
    margin-bottom: 1rem;
  }

  .skill-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brown);
  }

  .about-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 4rem;
  }

  @media (max-width: 1024px) {
    .about-intro {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .about-text {
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .about-photo-frame {
      width: 240px;
      height: 240px;
    }
  }
</style>
