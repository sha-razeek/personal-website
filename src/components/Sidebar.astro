---
const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Home' },
  { 
    href: '/about', 
    label: 'About',
    children: [
      { href: '/resume', label: 'Resume' },
      { href: '/portfolio', label: 'Portfolio' },
    ]
  },
  { href: '/favorites', label: 'Favorites' },
  { href: '/music/transistor', label: 'Transistor', featured: true },
  { href: '/projects/broadcast', label: 'Broadcast', featured: true },
  { href: '/music', label: 'Music' },
  { href: '/blog', label: 'Articles' },
  { href: '/gear', label: 'My Gear' },
  { href: '/projects', label: 'Projects' },
  { href: '/trivia', label: 'Trivia' },
  { href: '/wallpapers', label: 'Wallpapers' },
];
---
<!-- Mobile/Desktop Overlay Backdrop -->
<div id="nav-overlay" class="nav-overlay"></div>

<!-- Menu toggle button -->
<button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>

<header id="navbar" class="navbar">
  <div class="navbar-inner">
    <!-- Close button for mobile -->
    <button id="nav-close" class="nav-close" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <nav class="navbar-nav">
      {navItems.map(item => {
        const isCurrentParent = normalizedPath === item.href;
        const hasActiveChild = item.children && item.children.some(c => c.href === normalizedPath);
        const isActive = isCurrentParent || hasActiveChild;
        const showChildren = item.children && (item.href === '/about' ? isActive : true);

        return (
          <div class="nav-group">
            <a href={item.href} class={`nav-link ${isActive ? 'active' : ''} ${item.featured ? 'nav-link--featured' : ''}`}>
              <span class="nav-label">{item.label}</span>
            </a>
            {item.children && (
              <div class="nav-sub">
                {item.children.map(child => {
                  const isChildActive = normalizedPath === child.href;
                  return (
                    <a href={child.href} class={`nav-link nav-link--sub ${isChildActive ? 'active' : ''}`}>
                      <span class="nav-label">{child.label}</span>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>
  </div>
</header>

<style>
  /* ---- Overlay Backdrop ---- */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(38, 70, 83, 0.4);
    backdrop-filter: blur(8px);
    z-index: 1000;
    opacity: 0;
    transition: opacity var(--transition-medium);
  }

  .nav-overlay.active {
    display: block;
    opacity: 1;
  }

  /* ---- Nav Toggle ---- */
  .nav-toggle {
    display: none;
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1100;
    width: 48px;
    height: 48px;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-fast);
  }

  .nav-toggle.open .hamburger-line:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .nav-toggle.open .hamburger-line:nth-child(2) { opacity: 0; }
  .nav-toggle.open .hamburger-line:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-primary);
    transition: all var(--transition-fast);
  }

  /* ---- Navbar (Header) ---- */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 95;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    transition: all var(--transition-medium);
  }

  .navbar-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center; /* Center navigation items */
    padding: 0 var(--page-padding);
  }

  .navbar-nav {
    display: flex;
    flex-direction: row; /* Explicitly horizontal for desktop */
    gap: 0.5rem;
    align-items: center;
  }

  .nav-group {
    position: relative;
    display: flex;
    flex-direction: row; /* Explicitly horizontal for desktop */
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--accent-primary);
    background: rgba(42, 157, 143, 0.05);
  }

  .nav-link.active {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .nav-link.active::before {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 3px;
    background: var(--accent-primary);
    border-radius: 2px 2px 0 0;
  }

  .nav-close {
    display: none;
  }

  .nav-group:hover .nav-sub {
    display: flex;
  }

  .nav-sub {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem;
    min-width: 180px;
    display: none;
    flex-direction: column;
    z-index: 100;
  }

  .nav-link--sub {
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
  }

  /* ---- Mobile Top-down Overlay ( <= 1024px ) ---- */
  @media (max-width: 1024px) {
    .nav-close {
      display: flex;
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: none;
      border: none;
      color: var(--text-primary);
      cursor: pointer;
      padding: 0.5rem;
      transition: opacity var(--transition-fast);
    }

    .nav-close:hover {
      opacity: 0.7;
    }

    .navbar {
      top: 0;
      left: 0;
      transform: translateY(-100%);
      width: 100%;
      max-width: 100%;
      height: auto;
      max-height: 100vh;
      background: white;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-lg);
      padding: 5rem 1.5rem 2.5rem;
      overflow-y: auto;
      opacity: 1;
      visibility: visible;
      z-index: 1100;
      display: block; /* Vertical list */
    }

    .navbar.open {
      transform: translateY(0);
    }

    .navbar-inner {
      height: auto;
      padding: 0;
      display: block;
    }

    .navbar-nav {
      flex-direction: column;
      gap: 0.25rem;
      width: 100%;
    }

    .nav-group {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .nav-link {
      padding: 0.85rem 1rem;
      font-size: 1.15rem;
      justify-content: space-between;
    }

    .nav-link.active::before {
      bottom: auto;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 4px;
      height: 24px;
      border-radius: 0 2px 2px 0;
    }

    .nav-arrow {
      display: inline-block;
      opacity: 0.3;
    }

    .nav-sub {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 1px solid var(--border-color);
      margin-left: 1.5rem;
      margin-top: 0;
      padding: 0;
      display: flex;
    }

    .nav-group:hover .nav-sub {
      display: flex;
    }

    .nav-link--sub {
      font-size: 1rem;
      padding: 0.6rem 1rem;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupNav() {
    const toggle = document.getElementById('nav-toggle');
    const close = document.getElementById('nav-close');
    const navbar = document.getElementById('navbar');
    const overlay = document.getElementById('nav-overlay');

    if (!toggle || !navbar || !overlay) return;

    const closeNav = () => {
      navbar.classList.remove('open');
      overlay.classList.remove('active');
      toggle.classList.remove('open');
      document.body.style.overflow = '';
    };

    const openNav = () => {
      navbar.classList.add('open');
      overlay.classList.add('active');
      toggle.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      const isOpen = navbar.classList.contains('open');
      if (isOpen) closeNav();
      else openNav();
    });

    if (close) {
      close.addEventListener('click', closeNav);
    }

    overlay.addEventListener('click', closeNav);
  }

  // Handle both initial load and view transitions
  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
